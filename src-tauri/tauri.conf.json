{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Roj Czasteczek",
  "version": "1.1.0",
  "identifier": "com.vantorlab.roj-czasteczek",
  "build": { "frontendDist": "../app" },
  "app": {
    "windows": [
      { "title": "Rój Cząsteczek", "width": 1440, "height": 900, "minWidth": 960, "minHeight": 620, "center": true, "dragDropEnabled": false }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "VantorLab",
    "shortDescription": "Zdjęcie produktu → efektowne wideo reklamowe",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "languages": ["Polish", "English"], "installMode": "currentUser" }
    }
  }
}
